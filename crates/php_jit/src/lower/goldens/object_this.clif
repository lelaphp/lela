                                    store notrap aligned v649, v42+104  ; v649 = 4
                                    store.i64 notrap aligned v142, v648+112
                                    v651 = iconst.i32 4
                                    store notrap aligned v651, v648+120  ; v651 = 4
                                    v652 = iconst.i32 -2
                                    return v652  ; v652 = -2

                                block67 cold:
                                    v653 = iconst.i32 -4
                                    return v653  ; v653 = -4
}
