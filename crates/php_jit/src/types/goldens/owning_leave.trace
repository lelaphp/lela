start loop
root e2
op e2 11 long long - taken
op e2 5 - - - -
init e1
op e2 6 array.packed - - -
op e2 7 long - - -
op e2 8 - - - -
enter e1
op e1 2 - long - -
op e1 3 undef string - -
op e1 4 array.packed - - -
op e1 5 long long - -
op e1 6 long - - -
back
op e2 9 long long - -
op e2 10 long - - -
stop loop
