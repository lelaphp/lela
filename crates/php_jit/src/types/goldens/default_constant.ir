trace loop e4, stop loop
frame f0 e4 root, 3 cvs 6 temps
frame f1 e2 callee of f0, 2 cvs 1 temps
entry
  #0 f0.CV1 [long]
  #2 f0.CV2 [long]
  #4 f0.CV0 [long]
  guard room 128 -> exit 0
  guard #4 long -> exit 1
  guard #0 long -> exit 2
  guard #2 long -> exit 3
loop at 0, loop, interrupt exit 8
  #1 f0.CV1 [long] reg = phi(#0, #9)
  #3 f0.CV2 [long] reg = phi(#2, #10)
0009 f0 IS_SMALLER #3, #4 fused inline
  checks direction taken -> exit 4
0004 f0 INIT_FCALL const#2 inline
     f0 init e2 in-place
0005 f0 SEND_VAR #3 inline
0006 f0 DO_UCALL inline unwinds -> unwind 0
     f1 enter e2
  -> #5 f1.CV0 [long]
  -> #6 f1.CV1 [long]
  guard #6 long -> exit 5
0002 f1 ADD #5, #6 inline
  -> #7 f1.T0 [long] reg
  checks #7 long -> exit 6
0003 f1 RETURN #7 inline in-place
     f0 back to #8
  -> #8 f0.T2 [long]
0007 f0 ASSIGN_OP #1, #8 inline
  -> #9 f0.CV1 [long] reg
  checks #9 long -> exit 7
0008 f0 PRE_INC #3 inline
  -> #10 f0.CV2 [long] reg
end: back to 0
exit 0: f0 0009 plain to vm
exit 1: f0 0009 plain
exit 2: f0 0009 plain f0.CV0:long
exit 3: f0 0009 plain f0.CV0:long f0.CV1:long
exit 4: f0 0011 plain f0.CV1=#1 f0.CV2=#3 f0.CV0:long f0.CV1:long f0.CV2:long
exit 5: f1 0002 plain f0.CV1=#1 f0.CV2=#3 f1.CV0:long
exit 6: f1 0002 plain f0.CV1=#1 f0.CV2=#3 f1.CV0:long f1.CV1:long
exit 7: f0 0007 plain f0.CV1=#1 f0.CV2=#3 f0.CV0:long f0.CV1:long f0.CV2:long f0.T2:long
exit 8: f0 0009 plain f0.CV1=#1 f0.CV2=#3 f0.CV0:long f0.CV1:long f0.CV2:long to vm
unwind 0: f0.CV1=#1 f0.CV2=#3
