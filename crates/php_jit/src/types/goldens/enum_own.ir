trace loop e3, stop loop
frame f0 e3 root, 4 cvs 6 temps
frame f1 e6 callee of f0, 1 cvs 1 temps
entry
  #0 f0.CV2 [any]
  #2 f0.CV3 [long]
  #4 f0.CV1 [long]
  #5 f0.CV0 [object]
  guard #5 object -> exit 0
  guard #4 long -> exit 1
  guard #2 long -> exit 2
loop at 0, loop, interrupt exit 8
  #1 f0.CV2 [any] = phi(#0, #9)
  #3 f0.CV3 [long] reg = phi(#2, #10)
0010 f0 IS_SMALLER #3, #4 fused inline
  checks direction taken -> exit 3
0005 f0 INIT_METHOD_CALL #5, const#2 inline pair fn own of receiver map 0 unwinds -> unwind 0
  checks callee e6 -> exit 4
     f0 init e6 in-place
0006 f0 SEND_VAR #3 inline
0007 f0 DO_FCALL inline in-place unwinds -> unwind 0
  checks stands e6 0001 -> exit 5
     f1 enter e6
  -> #6 f1.CV0 [long]
0001 f1 MUL #6, int(2) inline
  -> #7 f1.T0 [long] reg
  checks #7 long -> exit 6
0002 f1 RETURN #7 inline receives in-place unwinds -> unwind 0
     f0 back to #8
  -> #8 f0.T2 [long]
0008 f0 ASSIGN #1, #8 inline unwinds -> unwind 1
  -> #9 f0.CV2 [long] reg
0009 f0 PRE_INC #3 inline
  -> #10 f0.CV3 [long] reg
  checks #10 long -> exit 7
end: back to 0
