#!/bin/sh
# docker-php-ext-install and docker-php-ext-enable for dax-php, whose
# extensions are compiled into php, php-cgi and php-fpm and cannot be
# loaded later. Each name given is checked to be built in: a built-in one
# succeeds with nothing to do, any other fails the build, so a Dockerfile
# written for php's image learns here what this image cannot give it.
set -e

cmd="$(basename "$0")"
names=
while [ "$#" -gt 0 ]; do
	case "$1" in
		-j) shift ;;          # -j N, the build's parallelism
		-j*|--ini-name) ;;    # --ini-name's value is skipped as a name below
		-*) ;;
		*) names="$names $1" ;;
	esac
	shift
done

if [ -z "$names" ]; then
	echo "usage: $cmd ext-name [ext-name ...]"
	echo "dax-php builds these in (php -m):"
	php -m | sed -n 's/^\([A-Za-z]\)/  \1/p'
	exit 1
fi

missing=
for name in $names; do
	case "$name" in
		*.ini) continue ;;
		opcache) check='Zend OPcache' ;;
		*) check="$name" ;;
	esac
	# shellcheck disable=SC2016 # php's $argv, not the shell's
	if php -r 'exit(extension_loaded($argv[1]) ? 0 : 1);' "$check"; then
		echo "$cmd: $name is built into dax-php; nothing to do"
	else
		missing="$missing $name"
	fi
done

if [ -n "$missing" ]; then
	echo "$cmd: not built into dax-php:$missing" >&2
	echo "$cmd: dax-php cannot compile or load extensions; 'php -m' lists the ones it has" >&2
	exit 1
fi
