# The services the packages lane provides (R11, spec lelaphp/lela#32), each
# at the fixed address every suite is given. The one place the three
# addresses are kept: `xtask packages` gives every install and suite these
# lines as its environment (xtask/src/packages, `SERVICES`), and the
# nightly job starts the services at them, docker compose reading this file
# with `--env-file` and a shell sourcing it. Only `KEY=VALUE` lines and
# comments, so both read it alike.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=test
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=test
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
