#!/usr/bin/env bash
# pre-commit: the instruments that exist, wired as harness-design.md §6
# lists them, over what this commit would take. fmt, then clippy on the
# crates with a staged change, api-check, budget, unsafe-audit and vocab,
# each a reading; `permit --diff` judges every staged file as the Write of
# its staged content and refuses the commit with the rule id on a denial
# (the harness's own files are a note: a person commits those). Last,
# `computed run` on the region files, always, since a staged change under
# a crate makes a region stale without staging its file, plus the local
# file by name, through `xtask regions`, which reads computed's exit once
# for every caller and refuses a broken marker, a missing computed and an
# untrusted clone; what it wrote is re-staged, and a hand-edited region is
# refused, since only a person runs --force. Every command's own exit is
# read; the commit is refused while any failed. Installed per clone by the
# SessionStart hook, or by hand: `git config core.hooksPath scripts/hooks`.
set -u
cd "$(git rev-parse --show-toplevel)"
X='cargo xtask'
status=0
step() {
    "$@" || { echo "pre-commit: $* failed" >&2; status=1; }
}
step cargo fmt --check
step $X clippy --staged
step $X api-check
step $X budget
step $X unsafe-audit
step $X vocab
step $X permit --diff

regions='AGENTS.md ext/AGENTS.md data/INDEX.md docs/divergence.md'
# shellcheck disable=SC2086
if rendered=$($X regions $regions .claude/harness.local.md); then
    echo "$rendered" | grep -E ' written$' | cut -d: -f1 | sort -u | while read -r file; do
        case " $regions " in *" $file "*) git add -- "$file" ;; esac
    done
else
    echo "pre-commit: the regions were not rendered; the line above says why" >&2
    status=1
fi
# shellcheck disable=SC2086
if ! computed check $regions >/dev/null 2>&1; then
    echo "pre-commit: a region is hand-edited or could not be rendered; run \`computed check\`:" >&2
    computed check $regions 2>&1 >&2 | grep -Ev ' fresh$' >&2
    status=1
fi
exit "$status"
