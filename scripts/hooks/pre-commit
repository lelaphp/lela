#!/usr/bin/env bash
# pre-commit: the instruments that exist, wired as harness-design.md §6
# lists them, over what this commit would take. fmt, then clippy and test
# on the crates with a staged change, api-check, budget, unsafe-audit,
# vocab and witness on the crates with a staged change, each a reading,
# so `done` has the readings its condition 1 asks a touched crate for;
# crosscheck over the default extensions writes its readings the same way
# and refuses nothing here, since a red row is an extension not yet
# ported and `done` is what holds a touched one to it (#269);
# `permit --diff` judges every staged file as the Write of
# its staged content and refuses the commit with the rule id on a denial
# (the harness's own files are a note: a person commits those). Last,
# `computed run` on the region files, always, since a staged change under
# a crate makes a region stale without staging its file, plus the local
# file by name, through `xtask regions`, which reads computed's exit once
# for every caller and refuses a broken marker, a missing computed and an
# untrusted clone; what it wrote is re-staged, and a hand-edited region is
# refused, since only a person runs --force. Every command's own exit is
# read; the commit is refused while any failed. When a path under
# harness-plugins/ is staged, the function-hook declarations are rewritten
# first (#62): harness-plugins/types is a tracked generated file, written
# by the committer's own Claude Code from a directory outside the clone
# with an empty HOME and CLAUDE_CONFIG_DIR, so no settings, plugin or hook
# load, under the variable that gates `/plugin-types`; `tsc` then holds
# the module to it and `plugin validate --strict` reads the manifest,
# hooks.json and the module, and what was written is staged. Without
# `claude` on PATH that step is skipped by name and the commit goes on:
# CI holds the module to the committed file. Installed per clone by the
# SessionStart hook, or by hand: `git config core.hooksPath scripts/hooks`.
set -u
cd "$(git rev-parse --show-toplevel)"
root=$PWD
X='cargo xtask'
status=0
step() {
    "$@" || { echo "pre-commit: $* failed" >&2; status=1; }
}
# What the hook stages goes into the index git hands it, the one the
# commit's tree is written from whether or not the commit names paths. A
# commit that names paths keeps a second index for after the commit,
# `index.lock`, which git renames into place and which would otherwise
# show what the hook staged as missing from the index, so that one takes
# it too.
stage() {
    git add -- "$@"
    case "${GIT_INDEX_FILE:-}" in
        *next-index-*) GIT_INDEX_FILE="$(git rev-parse --git-dir)/index.lock" git add -- "$@" ;;
    esac
}
# A node program (`claude`, `npx`) leaves O_NONBLOCK on the stdout it
# inherits, and every instrument after it through the same pipe then fails
# to print with EAGAIN; so each runs on a pipe of its own, its text echoed
# after, its exit read.
buffered() {
    local out exit
    out=$("$@" 2>&1)
    exit=$?
    [ -n "$out" ] && printf '%s\n' "$out"
    return "$exit"
}
declarations() {
    local outside exit
    outside=$(mktemp -d) || return 1
    mkdir -p "$outside/home" "$outside/config"
    (
        cd "$outside" && HOME="$outside/home" CLAUDE_CONFIG_DIR="$outside/config" \
            CLAUDE_CODE_ENABLE_FUNCTION_HOOKS=1 \
            buffered claude -p "/plugin-types $root/harness-plugins/types"
    )
    exit=$?
    rm -rf "$outside"
    return "$exit"
}
if ! git diff --cached --quiet -- harness-plugins; then
    if command -v claude >/dev/null 2>&1; then
        if declarations; then
            stage harness-plugins/types
        else
            echo "pre-commit: claude -p \"/plugin-types $root/harness-plugins/types\" failed; nothing of harness-plugins/types was staged" >&2
            status=1
        fi
        step buffered npx -y -p typescript@5.9.3 tsc -p harness-plugins
        step buffered claude plugin validate harness-plugins --strict
    else
        echo "pre-commit: claude is not on PATH; skipped rewriting harness-plugins/types, tsc and plugin validate" >&2
    fi
fi
step cargo fmt --check
step $X clippy --staged
step $X test --staged
step $X api-check
step $X budget
step $X unsafe-audit
step $X vocab
step $X witness --staged
$X crosscheck || echo "pre-commit: crosscheck: a default extension's rendering is not the oracle's; done holds a touched one to its row" >&2
step $X permit --diff

regions='AGENTS.md ext/AGENTS.md data/INDEX.md docs/divergence.md'
# shellcheck disable=SC2086
if rendered=$($X regions $regions .claude/harness.local.md); then
    echo "$rendered" | grep -E ' written$' | cut -d: -f1 | sort -u | while read -r file; do
        case " $regions " in *" $file "*) stage "$file" ;; esac
    done
else
    echo "pre-commit: the regions were not rendered; the line above says why" >&2
    status=1
fi
# shellcheck disable=SC2086
if ! computed check $regions >/dev/null 2>&1; then
    echo "pre-commit: a region is hand-edited or could not be rendered; run \`computed check\`:" >&2
    computed check $regions 2>&1 >&2 | grep -Ev ' fresh$' >&2
    status=1
fi
exit "$status"
