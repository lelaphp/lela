#!/usr/bin/env bash
# pre-commit: the instruments that exist, wired as harness-design.md §6
# lists them, over what this commit would take, the ones that only read
# the tree first (#1252): fmt, then at once api-check, budget,
# unsafe-audit, vocab and `permit --diff`, and a refusal among them ends
# the hook there, before clippy has built anything, since a vocab word or
# a missing lock line is seconds to find and a clippy and test cycle is
# minutes. Then clippy and test on the crates with a staged change; each
# writes a reading, so `done` has the readings its condition 1 asks a
# touched crate for, and witness is left to `done` (#2982). With `--staged` each leaves out a crate whose
# reading passes and was taken over exactly what is staged, naming the
# reading (#1143), a retired worktree's included, which is how a branch's
# passes stand at its merge (#1252). crosscheck is not run here: its exit
# was never read, so it refused nothing and cost a release build of every
# extension per engine commit; `done` asks a touched extension for its
# row, and `cargo xtask crosscheck --ext <name>` takes it (revision 140).
# Before anything runs, a commit from a session that does not own the
# checkout is refused (#3621), and a `git commit -F` whose file is missing is
# refused, since git reads the message only after this hook; a commit
# in a linked worktree, a builder's, runs at a lower priority than one
# in the main checkout, a merge (revision 140); and a `-F` message is
# noted against the glossary before the first instrument, as commit-msg
# notes a `-m` one, refusing nothing (#3630, #3629);
# `permit --diff` judges every staged file as the Write of
# its staged content and refuses the commit with the rule id on a denial
# (the harness's own files are a note: a person commits those; an agent's
# commit, `CLAUDE_CODE_SESSION_ID` set, that stages one no steer reading
# covers is refused, a merge's file taken whole from one side being that
# side's, #3644). Between
# the two groups and before clippy and test, `computed run` on the region
# files, always, so the map tests read the map the commit carries (#1416),
# and since a staged change under
# a crate makes a region stale without staging its file, through `xtask
# regions`, which reads computed's exit once
# for every caller and refuses a broken marker, a missing computed and an
# untrusted clone; what it wrote is re-staged, and a hand-edited region is
# refused, since only a person runs --force; a render an earlier, refused
# run wrote is staged too (#3638). The gitignored local file,
# .claude/harness.local.md, is not rendered here: no commit takes it, and
# every session re-renders it, so its render here could only refuse a
# commit for another session's write (#1312). Every command's own exit is
# read; a region refusal ends before clippy and test (#3611). Once the
# regions pass, clippy and test both run and either can refuse the commit.
# When a path under harness-plugins/ is staged, the function-hook declarations are rewritten
# first (#62): harness-plugins/types is a tracked generated file, written
# by the committer's own Claude Code as `declarations` below says, and
# staged; `tsc` then holds every plugin's modules and tests to it (#3831),
# and for each plugin under harness-plugins/ (the harness and the desk,
# #3490) `plugin validate --strict` reads the manifest, hooks.json and the
# module and `plugin test` runs its tests (#2247).
# Without `claude` on PATH that step is skipped by name and the commit
# goes on: CI holds the module to the committed file. A `claude` that is
# not logged in, or whose run extracts no declarations, is named the same
# way, and `tsc`, validate and test still run against the committed file;
# only a commit that stages harness-plugins/types itself is refused then,
# since no Claude Code here wrote what it carries (#1736). Installed per
# clone by the SessionStart hook, or by hand: `git config core.hooksPath
# scripts/hooks`.
set -u
cd "$(git rev-parse --show-toplevel)"
# What a `-F` message this hook noted leaves for commit-msg, so the
# message is held to the glossary once (#3630); one an earlier run left,
# refused before git wrote the message, is gone before anything else.
noted="$(git rev-parse --absolute-git-dir)/vocab-noted"
rm -f "$noted"
# The message file `git commit -F` names, read from the committing git's
# arguments, since git reads it only after this hook: a missing one
# refused a commit sixteen minutes into the hook twice in one session. A
# path is tried word by word, so one with a space in it is found; a
# relative one is tried against the directory git was started from, as
# git reads it, and then the checkout's root, and is not judged beside
# `-C`. The file found is printed as a whole path. Where the arguments
# cannot be read, nothing is judged and nothing is printed.
message_file() {
    local args word path=
    args=$(ps -ww -o args= -p "$PPID" 2>/dev/null) || return 0
    set -f
    # shellcheck disable=SC2086 # the words are what is wanted
    set -- $args
    set +f
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -F | --file) path=${2-} && shift ;;
            --file=*) path=${1#--file=} ;;
            --*) ;;
            -*F) path=${2-} && shift ;;
            -*F*) path=${1#*F} ;;
        esac
        shift
        [ -n "$path" ] && break
    done
    [ -n "$path" ] && [ "$path" != - ] || return 0
    case "$path" in /*) ;; *) case " $args " in *" -C "*) return 0 ;; esac ;; esac
    local from rest next
    from=$(lsof -a -p "$(ps -o ppid= -p "$PPID" | tr -d ' ')" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')
    # The words after the flag, joined one more at a time.
    word=$path
    rest=${args#*"$path"}
    while :; do
        case "$word" in
            /*) [ -r "$word" ] && printf '%s\n' "$word" && return 0 ;;
            *)
                [ -n "$from" ] && [ -r "$from/$word" ] && printf '%s\n' "$from/$word" && return 0
                [ -r "$word" ] && printf '%s\n' "$PWD/$word" && return 0
                ;;
        esac
        case "$rest" in " "*) ;; *) break ;; esac
        rest=${rest# }
        next=${rest%% *}
        word="$word $next"
        rest=${rest#"$next"}
    done
    echo "pre-commit: git commit -F names $path, which is not a file git can read, so the commit is refused before anything runs" >&2
    return 1
}
message=$(message_file) || exit 1
# One session writes in a checkout, its owner (#3618 M1, #3621): a commit
# from a session other than the one `xtask worktree add` or `xtask
# worktree own` recorded is refused before anything runs, whatever made
# the change, naming the owner and the checkout. A commit from no
# session is a person's, and is admitted.
cargo xtask worktree whose >/dev/null || exit 1
# A line the commit adds that git's own check reads as a conflict
# marker left in (`<<<<<<<`, `=======`, `>>>>>>>`, `|||||||`) refuses
# it, naming file and line: d0e168554, a merge `git commit` concluded
# through this hook, carried three into harness-design.md (#2996).
# pre-merge-commit runs the same check. A file that holds such a line on
# purpose is exempted in .gitattributes by `conflict-marker-size`, the
# one place.
if markers=$(git diff --cached --check | grep -E ': leftover conflict marker$'); then
    printf '%s\n' "$markers" >&2
    echo "pre-commit: the staged line above is a conflict marker left in; resolve it, or exempt a file that holds one on purpose by its conflict-marker-size in .gitattributes" >&2
    exit 1
fi
# A revision a commit on `main` or `staging` still cites as `NEXT`, the ledger row or
# prose such as "revisions 11 and NEXT", refuses it before anything runs,
# naming each line; `next-cited` beside this file says what is read and
# why, and pre-merge-commit asks it the same of a merge git commits itself.
if unnumbered=$("$(dirname "$0")/next-cited") && [ -n "$unnumbered" ]; then
    printf '%s\n' "$unnumbered" >&2
    echo "pre-commit: the revision cited above is still NEXT; number it as its ledger row is numbered before it lands on main" >&2
    exit 1
fi
# A builder commits from a linked worktree, whose .git is a file, while
# the coordinator merges in the merge worktree, the linked one on
# `staging` (#3622); the builder's hook and every build under it yield
# the cores to the merge, and the merge's own hook does not.
[ -f .git ] && [ "$(git symbolic-ref --short -q HEAD)" != staging ] &&
    renice -n 10 -p $$ >/dev/null 2>&1
X='cargo xtask'
# The `-F` message against the glossary before any build (#3630): commit-msg
# would hold it only once every instrument below has run, and an avoided
# word would be said minutes late. It notes and refuses nothing, as
# commit-msg does (#3629): the words are printed by line and one reading
# under `message` records them. Once it has, the message git will hand
# commit-msg is recorded as noted, as git cleans it (`git stripspace`), so
# commit-msg does not read it again; a `-m` message, or one an editor
# changed, is commit-msg's.
if [ -n "$message" ] && $X vocab --message "$message"; then
    git stripspace < "$message" | git hash-object --stdin > "$noted"
fi
status=0
step() {
    "$@" || { echo "pre-commit: $* failed" >&2; status=1; }
}
# What the hook stages goes into the index git hands it, the one the
# commit's tree is written from whether or not the commit names paths. A
# commit that names paths keeps a second index for after the commit,
# `index.lock`, which git renames into place and which would otherwise
# show what the hook staged as missing from the index, so that one takes
# it too.
stage() {
    git add -- "$@"
    case "${GIT_INDEX_FILE:-}" in
        *next-index-*) GIT_INDEX_FILE="$(git rev-parse --git-dir)/index.lock" git add -- "$@" ;;
    esac
}
# A node program (`claude`, `npx`) leaves O_NONBLOCK on the stdout it
# inherits, and every instrument after it through the same pipe then fails
# to print with EAGAIN; so each runs on a pipe of its own, its text echoed
# after, its exit read.
buffered() {
    local out exit
    out=$("$@" 2>&1)
    exit=$?
    [ -n "$out" ] && printf '%s\n' "$out"
    return "$exit"
}
# The declarations, as the committer's Claude Code writes them (#62,
# #1736). `/plugin-types` is gone (2.1.294 has no such command); a build writes
# the declarations into the files of its plugin-authoring skill, which it
# extracts under `CLAUDE_CODE_TMPDIR` when the skill is invoked, as
# <tmp>/claude-<uid>/bundled-skills/<version>/<id>/plugin-authoring/types/claude-code.d.ts,
# core declarations and this build's built-in tools in one file, the
# first line naming the version. So one `-p` invokes the skill, on the
# smallest model with no tool, and that one file is copied in; an exit of
# 0 with no such file is a build that wrote none, never a pass. It runs
# under the committer's own HOME and CLAUDE_CONFIG_DIR, where the login
# is (on macOS a keychain entry named for the config directory, so an
# empty one finds none), from a directory outside the clone, loading none
# of their settings sources (`--setting-sources ''`: no user, project or
# local file, so none of their hooks, enabled plugins or env), no MCP
# server (`--strict-mcp-config`) and no transcript; CMUX_CLAUDE_HOOKS_DISABLED
# is cmux's opt-out for the hooks its `claude` wrapper adds through
# `--settings`, which no setting source governs.
declarations() {
    local outside exit out
    outside=$(mktemp -d) || return 1
    mkdir -p "$outside/cwd" "$outside/tmp"
    out=$(
        cd "$outside/cwd" && CLAUDE_CODE_TMPDIR="$outside/tmp" \
            CLAUDE_CODE_ENABLE_FUNCTION_HOOKS=1 CMUX_CLAUDE_HOOKS_DISABLED=1 \
            claude -p --setting-sources '' --strict-mcp-config --tools '' \
            --model haiku --no-session-persistence \
            '/plugin-authoring Reply with the one word ok.' 2>&1
    )
    exit=$?
    set -- "$outside"/tmp/*/bundled-skills/*/*/plugin-authoring/types/claude-code.d.ts
    if [ "$exit" != 0 ]; then
        printf '%s\n' "$out" >&2
        echo "pre-commit: claude -p /plugin-authoring exited $exit" >&2
    elif [ "$#" != 1 ] || ! head -n 1 "$1" | grep -q '^// Written by Claude Code '; then
        exit=1
        echo "pre-commit: claude -p /plugin-authoring extracted no plugin-authoring/types/claude-code.d.ts naming its version" >&2
    else
        mkdir -p harness-plugins/types && cp "$1" harness-plugins/types/claude-code.d.ts || exit=1
    fi
    rm -rf "$outside"
    return "$exit"
}
# Declarations this commit could not have rewritten: said by name, and a
# refusal only when the commit stages harness-plugins/types itself.
unwritten() {
    if git diff --cached --quiet -- harness-plugins/types; then
        echo "pre-commit: $1; harness-plugins/types was not rewritten, and tsc holds the module to the committed file" >&2
    else
        echo "pre-commit: $1; the staged harness-plugins/types was written by no Claude Code here, so the commit is refused" >&2
        status=1
    fi
}
if ! git diff --cached --quiet -- harness-plugins; then
    if command -v claude >/dev/null 2>&1; then
        if ! claude auth status >/dev/null 2>&1; then
            # shellcheck disable=SC2016 # the backticks are the message's
            unwritten 'claude is not logged in (`claude auth status`)'
        elif declarations; then
            stage harness-plugins/types
        else
            unwritten 'claude wrote no declarations'
        fi
        step buffered npx -y -p typescript@5.9.3 tsc -p harness-plugins
        # Each plugin is a directory with a manifest (#3490), validated
        # and tested on its own; the declarations and tsc are shared.
        for manifest in harness-plugins/*/.claude-plugin/plugin.json; do
            [ -f "$manifest" ] || continue
            plugin=${manifest%/.claude-plugin/plugin.json}
            step buffered claude plugin validate "$plugin" --strict
            step buffered claude plugin test "$plugin"
        done
    else
        echo "pre-commit: claude is not on PATH; skipped rewriting harness-plugins/types, tsc, plugin validate and plugin test" >&2
    fi
fi
# A group of instruments run at once (#1144), each on a pipe of its own,
# as `buffered` runs one: its text kept whole in a file of its own,
# printed after all of them have ended and in the order they are listed,
# each exit read as `step` reads it. The first instrument to start builds
# xtask and the rest wait on cargo's lock for that one build.
at_once=$(mktemp -d) || exit 1
n=0
first=0
spawn() {
    n=$((n + 1))
    printf '%s\n' "$*" > "$at_once/$n.cmd"
    ( "$@" > "$at_once/$n.out" 2>&1; echo $? > "$at_once/$n.exit" ) &
}
gather() {
    local i=$first
    wait
    while [ "$i" -lt "$n" ]; do
        i=$((i + 1))
        cat "$at_once/$i.out"
        [ "$(cat "$at_once/$i.exit")" = 0 ] && continue
        echo "pre-commit: $(cat "$at_once/$i.cmd") failed" >&2
        status=1
    done
    first=$n
}
# What only reads the tree, first, and a refusal there is the hook's end.
step cargo fmt --check
spawn $X api-check --staged
spawn $X budget --staged
spawn $X unsafe-audit --staged
spawn $X vocab --staged
spawn $X permit --diff
gather
if [ "$status" != 0 ]; then
    rm -rf "$at_once"
    echo "pre-commit: refused before clippy and test ran; they measure the commit once what is above is fixed" >&2
    exit "$status"
fi
# The regions next, rendered and re-staged before anything that reads
# them runs (#1416): xtask's map tests read the map from the index, `git
# show :AGENTS.md`, so a commit that changes a region's inputs (a crate
# under ext/, a lock line, a rule) is tested against the map it will
# carry and not the one before the render. computed renders from the
# working tree, so `--staged` refuses, before anything is written, a
# region it would write that reads a path whose working copy the commit
# does not stage: rendered, it would carry that change (#2236).
regions='AGENTS.md ext/AGENTS.md data/INDEX.md docs/divergence.md harness-design.md third-engine-design.md'
# A render a refused run wrote, staged here (#3638). A pathspec commit
# refused after its regions were rendered and staged is rolled back to
# the index it started from, and the next run finds those regions fresh
# on disk and writes nothing, so the commit would carry the bodies from
# before the render. So a region file is staged where its working copy
# differs from the commit's index only inside its regions, the two equal
# once `computed clean` has emptied each, and where `computed affected`
# says one of its regions reads a staged path. A tree region reads the
# directories it lists, so a directory a staged path adds or takes away
# is asked about as itself, as `--staged` asks about an untracked one.
# A file that also differs outside its regions holds a person's line, not
# the commit's, and is left; where its regions differ too, their closers'
# sums not the index's, the commit carries them unrendered, so the file is
# named with the first staged path its region reads, a note as a person's
# change elsewhere is, refusing nothing (#3645). This runs before `xtask
# regions --staged`, whose check then holds what was staged here as it
# holds every file the commit stages.
rendered_before() {
    local file dir read differ=() paths=() affected tmp
    for file in $regions; do
        git diff --quiet -- "$file" || differ+=("$file")
    done
    [ "${#differ[@]}" != 0 ] || return 0
    while IFS= read -r file; do
        paths+=("$file")
    done < <(
        git diff --cached --name-only
        git diff --cached --name-only --diff-filter=AD | while IFS= read -r file; do
            dir=$file
            while [ "${dir#*/}" != "$dir" ]; do
                dir=${dir%/*}
                if ! git cat-file -e "HEAD:$dir" 2>/dev/null || [ -z "$(git ls-files -- "$dir")" ]; then
                    printf '%s\n' "$dir"
                fi
            done
        done | sort -u
    )
    [ "${#paths[@]}" != 0 ] || return 0
    affected=$(computed affected "${paths[@]}" 2>/dev/null | cut -d: -f1 | sort -u)
    tmp=$(mktemp -d) || return 0
    for file in "${differ[@]}"; do
        printf '%s\n' "$affected" | grep -qxF -- "$file" || continue
        rm -rf "${tmp:?}/working" "${tmp:?}/index"
        mkdir -p "$tmp/working" "$tmp/index"
        if ! cp -- "$file" "$tmp/working/${file##*/}" ||
            ! git show ":$file" > "$tmp/index/${file##*/}" 2>/dev/null; then
            continue
        fi
        (cd "$tmp/working" && computed clean -- "${file##*/}" >/dev/null 2>&1)
        (cd "$tmp/index" && computed clean -- "${file##*/}" >/dev/null 2>&1)
        if cmp -s "$tmp/working/${file##*/}" "$tmp/index/${file##*/}"; then
            stage "$file"
            echo "pre-commit: staged $file, whose regions an earlier run rendered from what this commit stages (#3638)"
        elif ! cmp -s <(grep -F '<!-- /computed' "$file") <(git show ":$file" | grep -F '<!-- /computed'); then
            for read in "${paths[@]}"; do
                computed affected "$read" 2>/dev/null | cut -d: -f1 | grep -qxF -- "$file" || continue
                echo "pre-commit: left $file unstaged, whose region reads $read, which this commit stages: it holds a change outside its regions, so the commit carries the region unrendered until $file is staged (#3645)"
                break
            done
        fi
    done
    rm -rf "$tmp"
}
rendered_before
# shellcheck disable=SC2086
if rendered=$($X regions --staged $regions); then
    echo "$rendered" | grep -E ' written$' | cut -d: -f1 | sort -u | while read -r file; do
        case " $regions " in *" $file "*) stage "$file" ;; esac
    done
else
    echo "pre-commit: the regions were not rendered; the line above says why" >&2
    status=1
fi
# shellcheck disable=SC2086
if ! computed check $regions >/dev/null 2>&1; then
    echo "pre-commit: a region is hand-edited or could not be rendered; run \`computed check\`:" >&2
    computed check $regions 2>&1 >&2 | grep -Ev ' fresh$' >&2
    status=1
fi
rm -rf "$at_once"
if [ "$status" != 0 ]; then
    echo "pre-commit: refused before clippy and test ran; fix the regions above" >&2
    exit "$status"
fi
step $X clippy --staged
step $X test --staged
# No witness here (#2982): it builds the lanes' optimised binary, minutes
# per commit where clippy and test take seconds, and a branch of small
# commits paid it on each. A branch is witnessed once, where `done` asks
# the witness of each crate it touched before it is ready, and `main` in
# the merge check's `witness --unmeasured` (the specs skill, §6).

exit "$status"
