#!/usr/bin/env bash
# pre-merge-commit: a merge `git merge` commits itself runs this hook and
# not pre-commit, and git has written the merge's tree before it runs, so
# what a hook stages here never reaches the commit. `computed merge`, the
# driver .gitattributes routes Markdown through, leaves a region both
# sides re-rendered unrendered, a bare closer; committed so, it broke the
# map on `main` four times (#2744). So a region file the merge would
# commit with a region that is not fresh refuses the merge, which stands
# uncommitted, and `git commit` finishes it through pre-commit, whose
# regions step renders and re-stages the region. A merge whose regions
# are fresh is committed as git made it. Installed per clone by the
# SessionStart hook, or by hand: `git config core.hooksPath scripts/hooks`.
set -u
# The region files are pre-commit's `regions=` line, the one list (#631).
regions=$(sed -n "s/^regions='\(.*\)'$/\1/p" "$(dirname "$0")/pre-commit")
cd "$(git rev-parse --show-toplevel)" || exit 1
# A conflict marker left in, which the merge would add, refuses it, as
# pre-commit's check does, naming file and line (#2996).
if markers=$(git diff --cached --check | grep -E ': leftover conflict marker$'); then
    printf '%s\n' "$markers" >&2
    echo "pre-merge-commit: the line above is a conflict marker left in, which the merge would commit; the merge stands uncommitted: resolve it, or exempt a file that holds one on purpose by its conflict-marker-size in .gitattributes" >&2
    exit 1
fi
# A revision still cited as `NEXT`, which the merge would bring onto
# `main`, refuses it, as pre-commit's check does, naming each line.
if unnumbered=$("$(dirname "$0")/next-cited") && [ -n "$unnumbered" ]; then
    printf '%s\n' "$unnumbered" >&2
    echo "pre-merge-commit: the revision cited above is still NEXT, which the merge would bring onto main; the merge stands uncommitted: number it as its ledger row is numbered, and \`git commit\` finishes it through pre-commit" >&2
    exit 1
fi
if [ -z "$regions" ]; then
    echo "pre-merge-commit: pre-commit names no region files as regions='...', so the merge's regions are unread; the merge stands uncommitted" >&2
    exit 1
fi
if ! command -v computed >/dev/null 2>&1; then
    echo "pre-merge-commit: computed did not run (cargo install computed), so the merge's regions are unread; the merge stands uncommitted" >&2
    exit 1
fi
# computed reads the working tree and the merge commits the index, so a
# region file whose working copy is not what is staged is one `computed
# check` cannot speak for.
# shellcheck disable=SC2086
if ! git diff --quiet -- $regions; then
    # shellcheck disable=SC2086
    git diff --name-only -- $regions >&2
    echo "pre-merge-commit: the working copy of the region file above is not what the merge would commit, so its regions are unread; the merge stands uncommitted: stage or restore the file, and \`git commit\` finishes it through pre-commit" >&2
    exit 1
fi
# shellcheck disable=SC2086
said=$(computed check $regions 2>&1) && exit 0
printf '%s\n' "$said" | grep -Ev ' fresh$' >&2
echo "pre-merge-commit: the merge would commit the region above as it stands, and this hook cannot stage a render into it (#2744); the merge stands uncommitted: \`git commit\` finishes it through pre-commit, which renders the region or says why it cannot" >&2
exit 1
