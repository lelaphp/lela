#!/usr/bin/env bash
# pre-push: the definition of done, run by the person before the push
# (harness-design.md §4.5, §6). git hands the hook one line per ref on
# stdin, `<local ref> <local sha> <remote ref> <remote sha>`; `xtask done
# --base <remote sha>` prints what is unmet in everything the push would
# add and exits 1 while anything is, which refuses the push. A ref the
# remote does not have yet (its sha all zeros) is judged since done's own
# default, the merge base with the branch's track. A deletion (the local
# sha all zeros) adds nothing, so there is nothing to judge; a branch with
# no history in common with its base, as dashboard-data was, would
# otherwise fail on the merge base. Installed per clone by the SessionStart
# hook, or by hand: `git config core.hooksPath scripts/hooks`. It goes
# through cargo run, which rebuilds a stale binary rather than trusting
# it; a person pushes once, so the build cost is nothing.
set -eu
cd "$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
status=0
while read -r _local local_sha _remote remote_sha; do
    if [ "$local_sha" = "$zero" ]; then
        continue
    elif [ "$remote_sha" = "$zero" ]; then
        cargo xtask done || status=1
    else
        cargo xtask done --base "$remote_sha" || status=1
    fi
done
exit "$status"
