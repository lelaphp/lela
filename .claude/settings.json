{
  "env": {
    "BASH_MAX_TIMEOUT_MS": "2700000",
    "CARGO_BUILD_JOBS": 4
  },
  "permissions": {
    "allow": [
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(~/Projects/dax-php/target/release/xtask ticket close:*)"
    ]
  },
  "enabledPlugins": {
    "harness@dax-php": true,
    "desk@dax-php": true
  },
  "extraKnownMarketplaces": {
    "dax-php": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  }
}
